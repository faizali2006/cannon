NODE_ENV=development
PORT=8787

# Use demo only for local browser development. Production must use firebase.
AUTH_MODE=demo
FIREBASE_PROJECT_ID=
FIREBASE_CHECK_REVOKED=true

# Required in production. Generate a random value of at least 32 characters.
MEDIA_SIGNING_KEY=
MEDIA_URL_TTL_SECONDS=900
CORS_ALLOWED_ORIGINS=http://localhost:8787,http://localhost:5173,https://localhost

# Set live and provide exactly one server-side provider key for real enhancement.
AI_MODE=live
ALLOW_DEMO_AI=false
AI_PROVIDER=deepai
DEEPAI_API_KEY=9faaa0d8-af7f-4a97-bffc-c37abfcd8425
OPENAI_API_KEY=

MAX_IMAGE_DIMENSION=6000
MAX_IMAGE_PIXELS=24000000

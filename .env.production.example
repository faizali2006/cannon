VITE_API_ORIGIN=https://YOUR-CLOUD-RUN-URL.run.app
VITE_AUTH_MODE=twilio
VITE_RELEASE=true
NODE_ENV=production
AUTH_MODE=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
JWT_SECRET=replace-with-at-least-32-random-characters-for-jwt
MEDIA_SIGNING_KEY=replace-with-at-least-32-random-characters
MEDIA_URL_TTL_SECONDS=900
CORS_ALLOWED_ORIGINS=https://localhost,https://your-web-origin.example
AI_MODE=live
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-server-side-secret
ASSET_RIGHTS_CONFIRMED=false
LEGAL_TRANSLATIONS_REVIEWED=false
LEGAL_REVIEW_CONFIRMED=false
